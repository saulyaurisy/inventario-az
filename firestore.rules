rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveRole(role) {
      return isSignedIn()
        && currentUser().active == true
        && currentUser().role == role;
    }

    function isAdmin() {
      return isActiveRole('admin');
    }

    function isAgent() {
      return isActiveRole('agent');
    }

    function isStaff() {
      return isAdmin() || isAgent();
    }

    function hasValidProductShape(data) {
      return data.keys().hasAll([
          'sku',
          'name',
          'category',
          'salePrice',
          'costPrice',
          'minimumStock',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'sku',
          'internalCode',
          'name',
          'description',
          'category',
          'salePrice',
          'costPrice',
          'minimumStock',
          'active',
          'createdAt',
          'updatedAt'
        ])
        && data.sku is string
        && data.sku.size() > 0
        && data.sku.size() <= 100
        && data.sku.matches('^[A-Z0-9][A-Z0-9._ -]*$')
        && data.name is string
        && data.name.size() > 0
        && data.category is string
        && data.category.size() > 0
        && data.salePrice is number
        && data.salePrice >= 0
        && data.costPrice is number
        && data.costPrice >= 0
        && data.minimumStock is int
        && data.minimumStock >= 0
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['internalCode']) || data.internalCode is string)
        && (!data.keys().hasAny(['description']) || data.description is string);
    }

    function hasValidClientShape(data) {
      return data.keys().hasAll([
          'documentType',
          'documentNumber',
          'normalizedDocumentNumber',
          'name',
          'active',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'documentType',
          'documentNumber',
          'normalizedDocumentNumber',
          'name',
          'phone',
          'email',
          'address',
          'notes',
          'active',
          'createdBy',
          'updatedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.documentType in ['DNI', 'RUC', 'CE', 'OTHER']
        && data.documentNumber is string
        && data.documentNumber == data.normalizedDocumentNumber
        && data.normalizedDocumentNumber is string
        && data.normalizedDocumentNumber.size() > 0
        && data.normalizedDocumentNumber.size() <= 100
        && data.normalizedDocumentNumber.matches('^[A-Z0-9][A-Z0-9._ -]*$')
        && data.name is string
        && data.name.size() > 0
        && data.active is bool
        && data.createdBy is string
        && data.updatedBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['phone']) || data.phone is string)
        && (!data.keys().hasAny(['email']) || data.email is string)
        && (!data.keys().hasAny(['address']) || data.address is string)
        && (!data.keys().hasAny(['notes']) || data.notes is string);
    }

    function hasValidInventoryShape(data) {
      return data.keys().hasAll([
          'productId', 'ownerType', 'ownerId', 'quantity',
          'lastMovementId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'productId', 'ownerType', 'ownerId', 'quantity',
          'lastMovementId', 'createdAt', 'updatedAt'
        ])
        && data.productId is string
        && data.ownerType in ['company', 'agent']
        && data.ownerId is string
        && data.quantity is int
        && data.quantity >= 0
        && data.lastMovementId is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function hasValidMovementShape(data) {
      return data.keys().hasAll([
          'inventoryId', 'productId', 'ownerType', 'ownerId', 'type',
          'quantity', 'quantityBefore', 'quantityAfter', 'reason',
          'createdBy', 'createdAt'
        ])
        && data.keys().hasOnly([
          'inventoryId', 'productId', 'ownerType', 'ownerId', 'type',
          'quantity', 'quantityBefore', 'quantityAfter', 'reason',
          'referenceType', 'referenceId', 'createdBy', 'createdAt'
        ])
        && data.inventoryId is string
        && data.productId is string
        && data.ownerType in ['company', 'agent']
        && data.ownerId is string
        && data.type in [
          'initial', 'adjustment_in', 'adjustment_out',
          'replenishment_out', 'replenishment_in', 'sale'
        ]
        && data.quantity is int
        && data.quantity > 0
        && data.quantityBefore is int
        && data.quantityBefore >= 0
        && data.quantityAfter is int
        && data.quantityAfter >= 0
        && data.reason is string
        && data.reason.size() > 0
        && (!data.keys().hasAny(['referenceType']) || data.referenceType is string)
        && (!data.keys().hasAny(['referenceId']) || data.referenceId is string)
        && data.createdBy is string
        && data.createdAt is timestamp;
    }

    function movementMatchesInventory(movementId, data) {
      let inventory = getAfter(/databases/$(database)/documents/inventory/$(data.inventoryId)).data;
      return inventory.lastMovementId == movementId
        && inventory.productId == data.productId
        && inventory.ownerType == data.ownerType
        && inventory.ownerId == data.ownerId
        && inventory.quantity == data.quantityAfter;
    }

    function validInventoryOwner(data) {
      return data.ownerType == 'company' && data.ownerId == 'company'
        || data.ownerType == 'agent'
          && exists(/databases/$(database)/documents/users/$(data.ownerId))
          && get(/databases/$(database)/documents/users/$(data.ownerId)).data.role == 'agent'
          && get(/databases/$(database)/documents/users/$(data.ownerId)).data.active == true;
    }

    function validInitialMovement(inventoryId, inventoryData) {
      let movement = getAfter(/databases/$(database)/documents/inventory_movements/$(inventoryData.lastMovementId)).data;
      return existsAfter(/databases/$(database)/documents/inventory_movements/$(inventoryData.lastMovementId))
        && movement.inventoryId == inventoryId
        && movement.productId == inventoryData.productId
        && movement.ownerType == inventoryData.ownerType
        && movement.ownerId == inventoryData.ownerId
        && movement.type == 'initial'
        && movement.quantity == inventoryData.quantity
        && movement.quantityBefore == 0
        && movement.quantityAfter == inventoryData.quantity
        && movement.createdBy == request.auth.uid;
    }

    function validAdjustmentMovement(inventoryId, beforeQuantity, inventoryData) {
      let movement = getAfter(/databases/$(database)/documents/inventory_movements/$(inventoryData.lastMovementId)).data;
      return existsAfter(/databases/$(database)/documents/inventory_movements/$(inventoryData.lastMovementId))
        && movement.inventoryId == inventoryId
        && movement.productId == inventoryData.productId
        && movement.ownerType == inventoryData.ownerType
        && movement.ownerId == inventoryData.ownerId
        && movement.type in ['adjustment_in', 'adjustment_out']
        && movement.quantityBefore == beforeQuantity
        && movement.quantityAfter == inventoryData.quantity
        && movement.createdBy == request.auth.uid
        && (
          movement.type == 'adjustment_in'
            && movement.quantityAfter == movement.quantityBefore + movement.quantity
          || movement.type == 'adjustment_out'
            && movement.quantityAfter == movement.quantityBefore - movement.quantity
        );
    }

    function validReplenishmentItem(item) {
      return item is map
        && item.keys().hasAll(['productId', 'quantity'])
        && item.keys().hasOnly(['productId', 'quantity'])
        && item.productId is string
        && item.productId.size() > 0
        && item.quantity is int
        && item.quantity > 0;
    }

    function validReplenishmentItems(items) {
      return items is list
        && items.size() > 0
        && items.size() <= 3
        && validReplenishmentItem(items[0])
        && (items.size() < 2 || validReplenishmentItem(items[1]))
        && (items.size() < 3 || validReplenishmentItem(items[2]))
        && (items.size() < 2 || items[0].productId != items[1].productId)
        && (items.size() < 3 || (
          items[0].productId != items[2].productId
          && items[1].productId != items[2].productId
        ));
    }

    function validReplenishmentAgent(agentId) {
      return get(/databases/$(database)/documents/users/$(agentId)).data.role == 'agent'
        && get(/databases/$(database)/documents/users/$(agentId)).data.active == true;
    }

    function validActiveReplenishmentProducts(items) {
      return get(/databases/$(database)/documents/products/$(items[0].productId)).data.active == true
        && (items.size() < 2 || (
          get(/databases/$(database)/documents/products/$(items[1].productId)).data.active == true
        ))
        && (items.size() < 3 || (
          get(/databases/$(database)/documents/products/$(items[2].productId)).data.active == true
        ));
    }

    function validReplenishmentShape(data) {
      return data.keys().hasAll([
          'number', 'status', 'agentId', 'items', 'notes',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.number is string
        && data.number.matches('^REP-[0-9]{6,}$')
        && data.status in ['pending', 'sent', 'received', 'cancelled']
        && data.agentId is string
        && validReplenishmentItems(data.items)
        && data.notes is string
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          data.status == 'pending'
            && data.keys().hasOnly([
              'number', 'status', 'agentId', 'items', 'notes',
              'createdBy', 'createdAt', 'updatedAt'
            ])
          || data.status == 'sent'
            && data.keys().hasAll(['sentBy', 'sentAt'])
            && data.keys().hasOnly([
              'number', 'status', 'agentId', 'items', 'notes',
              'createdBy', 'createdAt', 'updatedAt', 'sentBy', 'sentAt'
            ])
            && data.sentBy is string
            && data.sentAt is timestamp
          || data.status == 'received'
            && data.keys().hasAll(['sentBy', 'sentAt', 'receivedBy', 'receivedAt'])
            && data.keys().hasOnly([
              'number', 'status', 'agentId', 'items', 'notes',
              'createdBy', 'createdAt', 'updatedAt', 'sentBy', 'sentAt',
              'receivedBy', 'receivedAt'
            ])
            && data.sentBy is string
            && data.sentAt is timestamp
            && data.receivedBy is string
            && data.receivedAt is timestamp
          || data.status == 'cancelled'
            && data.keys().hasAll(['cancelledBy', 'cancelledAt'])
            && data.keys().hasOnly([
              'number', 'status', 'agentId', 'items', 'notes',
              'createdBy', 'createdAt', 'updatedAt',
              'cancelledBy', 'cancelledAt'
            ])
            && data.cancelledBy is string
            && data.cancelledAt is timestamp
        );
    }

    function unchangedReplenishmentCore(before, after) {
      return after.number == before.number
        && after.agentId == before.agentId
        && after.items == before.items
        && after.notes == before.notes
        && after.createdBy == before.createdBy
        && after.createdAt == before.createdAt;
    }

    function itemMatches(items, productId, quantity) {
      return items[0].productId == productId && items[0].quantity == quantity
        || items.size() > 1
          && items[1].productId == productId && items[1].quantity == quantity
        || items.size() > 2
          && items[2].productId == productId && items[2].quantity == quantity;
    }

    function validSentItem(replenishmentId, item) {
      let inventoryId = 'company__company__' + item.productId;
      let movementId = 'replenishment__' + replenishmentId + '__sent__' + item.productId;
      let beforeInventory = get(/databases/$(database)/documents/inventory/$(inventoryId)).data;
      let afterInventory = getAfter(/databases/$(database)/documents/inventory/$(inventoryId)).data;
      let movement = getAfter(/databases/$(database)/documents/inventory_movements/$(movementId)).data;
      return beforeInventory.quantity >= item.quantity
        && afterInventory.productId == item.productId
        && afterInventory.ownerType == 'company'
        && afterInventory.ownerId == 'company'
        && afterInventory.quantity == beforeInventory.quantity - item.quantity
        && afterInventory.lastMovementId == movementId
        && afterInventory.createdAt == beforeInventory.createdAt
        && movement.inventoryId == inventoryId
        && movement.productId == item.productId
        && movement.ownerType == 'company'
        && movement.ownerId == 'company'
        && movement.type == 'replenishment_out'
        && movement.quantity == item.quantity
        && movement.quantityBefore == beforeInventory.quantity
        && movement.quantityAfter == afterInventory.quantity
        && movement.referenceType == 'replenishment'
        && movement.referenceId == replenishmentId
        && movement.createdBy == request.auth.uid;
    }

    function validAllSentItems(replenishmentId, items) {
      return validSentItem(replenishmentId, items[0])
        && (items.size() < 2 || validSentItem(replenishmentId, items[1]))
        && (items.size() < 3 || validSentItem(replenishmentId, items[2]));
    }

    function validReceivedItem(replenishmentId, agentId, item) {
      let inventoryId = 'agent__' + agentId + '__' + item.productId;
      let movementId = 'replenishment__' + replenishmentId + '__received__' + item.productId;
      let afterInventory = getAfter(/databases/$(database)/documents/inventory/$(inventoryId)).data;
      let movement = getAfter(/databases/$(database)/documents/inventory_movements/$(movementId)).data;
      return afterInventory.productId == item.productId
        && afterInventory.ownerType == 'agent'
        && afterInventory.ownerId == agentId
        && afterInventory.lastMovementId == movementId
        && movement.inventoryId == inventoryId
        && movement.productId == item.productId
        && movement.ownerType == 'agent'
        && movement.ownerId == agentId
        && movement.type == 'replenishment_in'
        && movement.quantity == item.quantity
        && movement.quantityBefore >= 0
        && movement.quantityAfter == movement.quantityBefore + item.quantity
        && movement.quantityAfter == afterInventory.quantity
        && movement.referenceType == 'replenishment'
        && movement.referenceId == replenishmentId
        && movement.createdBy == request.auth.uid;
    }

    function validAllReceivedItems(replenishmentId, agentId, items) {
      return validReceivedItem(replenishmentId, agentId, items[0])
        && (items.size() < 2 || validReceivedItem(replenishmentId, agentId, items[1]))
        && (items.size() < 3 || validReceivedItem(replenishmentId, agentId, items[2]));
    }

    function validReplenishmentInventoryOut(before, after) {
      let movement = getAfter(/databases/$(database)/documents/inventory_movements/$(after.lastMovementId)).data;
      let replenishmentId = movement.referenceId;
      let beforeReplenishment = get(/databases/$(database)/documents/replenishments/$(replenishmentId)).data;
      let afterReplenishment = getAfter(/databases/$(database)/documents/replenishments/$(replenishmentId)).data;
      return isAdmin()
        && movement.type == 'replenishment_out'
        && movement.referenceType == 'replenishment'
        && movement.inventoryId == 'company__company__' + after.productId
        && movement.productId == after.productId
        && movement.ownerType == 'company'
        && movement.ownerId == 'company'
        && movement.quantity == before.quantity - after.quantity
        && movement.quantityBefore == before.quantity
        && movement.quantityAfter == after.quantity
        && movement.createdBy == request.auth.uid
        && after.lastMovementId == 'replenishment__' + replenishmentId + '__sent__' + after.productId
        && beforeReplenishment.status == 'pending'
        && afterReplenishment.status == 'sent'
        && afterReplenishment.sentBy == request.auth.uid
        && itemMatches(afterReplenishment.items, after.productId, before.quantity - after.quantity);
    }

    function validReplenishmentInventoryIn(beforeQuantity, after) {
      let movement = getAfter(/databases/$(database)/documents/inventory_movements/$(after.lastMovementId)).data;
      let replenishmentId = movement.referenceId;
      let beforeReplenishment = get(/databases/$(database)/documents/replenishments/$(replenishmentId)).data;
      let afterReplenishment = getAfter(/databases/$(database)/documents/replenishments/$(replenishmentId)).data;
      return isAgent()
        && after.ownerType == 'agent'
        && after.ownerId == request.auth.uid
        && movement.type == 'replenishment_in'
        && movement.referenceType == 'replenishment'
        && movement.inventoryId == 'agent__' + request.auth.uid + '__' + after.productId
        && movement.productId == after.productId
        && movement.ownerType == 'agent'
        && movement.ownerId == request.auth.uid
        && movement.quantity == after.quantity - beforeQuantity
        && movement.quantityBefore == beforeQuantity
        && movement.quantityAfter == after.quantity
        && movement.createdBy == request.auth.uid
        && after.lastMovementId == 'replenishment__' + replenishmentId + '__received__' + after.productId
        && beforeReplenishment.status == 'sent'
        && beforeReplenishment.agentId == request.auth.uid
        && afterReplenishment.status == 'received'
        && afterReplenishment.receivedBy == request.auth.uid
        && itemMatches(afterReplenishment.items, after.productId, after.quantity - beforeQuantity);
    }

    function validReplenishmentMovement(movementId, data) {
      let replenishmentId = data.referenceId;
      let beforeReplenishment = get(/databases/$(database)/documents/replenishments/$(replenishmentId)).data;
      let afterReplenishment = getAfter(/databases/$(database)/documents/replenishments/$(replenishmentId)).data;
      return data.referenceType == 'replenishment'
        && data.createdBy == request.auth.uid
        && data.quantityAfter >= 0
        && existsAfter(/databases/$(database)/documents/inventory/$(data.inventoryId))
        && getAfter(/databases/$(database)/documents/inventory/$(data.inventoryId)).data.lastMovementId == movementId
        && getAfter(/databases/$(database)/documents/inventory/$(data.inventoryId)).data.quantity == data.quantityAfter
        && (
          isAdmin()
            && data.type == 'replenishment_out'
            && data.ownerType == 'company'
            && data.ownerId == 'company'
            && data.inventoryId == 'company__company__' + data.productId
            && movementId == 'replenishment__' + replenishmentId + '__sent__' + data.productId
            && beforeReplenishment.status == 'pending'
            && afterReplenishment.status == 'sent'
            && afterReplenishment.sentBy == request.auth.uid
            && itemMatches(afterReplenishment.items, data.productId, data.quantity)
            && data.quantityAfter == data.quantityBefore - data.quantity
          || isAgent()
            && data.type == 'replenishment_in'
            && data.ownerType == 'agent'
            && data.ownerId == request.auth.uid
            && data.inventoryId == 'agent__' + request.auth.uid + '__' + data.productId
            && movementId == 'replenishment__' + replenishmentId + '__received__' + data.productId
            && beforeReplenishment.status == 'sent'
            && beforeReplenishment.agentId == request.auth.uid
            && afterReplenishment.status == 'received'
            && afterReplenishment.receivedBy == request.auth.uid
            && itemMatches(afterReplenishment.items, data.productId, data.quantity)
            && data.quantityAfter == data.quantityBefore + data.quantity
        );
    }

    function validSaleItem(item) {
      return item is map
        && item.keys().hasAll([
          'productId', 'sku', 'name', 'quantity', 'unitPrice', 'unitCost',
          'lineSubtotal', 'discountAmount', 'lineTotal'
        ])
        && item.keys().hasOnly([
          'productId', 'sku', 'name', 'quantity', 'unitPrice', 'unitCost',
          'lineSubtotal', 'discountType', 'discountValue',
          'discountAmount', 'lineTotal'
        ])
        && item.productId is string
        && item.productId.size() > 0
        && item.sku is string
        && item.sku.size() > 0
        && item.name is string
        && item.name.size() > 0
        && item.quantity is int
        && item.quantity > 0
        && item.unitPrice is int
        && item.unitPrice >= 0
        && item.unitCost is int
        && item.unitCost >= 0
        && item.lineSubtotal is int
        && item.lineSubtotal == item.unitPrice * item.quantity
        && item.discountAmount is int
        && item.discountAmount >= 0
        && item.discountAmount <= item.lineSubtotal
        && item.lineTotal is int
        && item.lineTotal == item.lineSubtotal - item.discountAmount
        && (
          !item.keys().hasAny(['discountType', 'discountValue'])
          || item.keys().hasAll(['discountType', 'discountValue'])
            && item.discountType in ['percentage', 'fixed']
            && item.discountValue is number
            && item.discountValue >= 0
            && (item.discountType != 'percentage' || item.discountValue <= 100)
        );
    }

    function validSaleItems(items) {
      return items is list
        && items.size() > 0
        && items.size() <= 3
        && validSaleItem(items[0])
        && (items.size() < 2 || validSaleItem(items[1]))
        && (items.size() < 3 || validSaleItem(items[2]))
        && (items.size() < 2 || items[0].productId != items[1].productId)
        && (items.size() < 3 || (
          items[0].productId != items[2].productId
          && items[1].productId != items[2].productId
        ));
    }

    function saleSubtotal(items) {
      return items[0].lineSubtotal
        + (items.size() > 1 ? items[1].lineSubtotal : 0)
        + (items.size() > 2 ? items[2].lineSubtotal : 0);
    }

    function saleLineDiscount(items) {
      return items[0].discountAmount
        + (items.size() > 1 ? items[1].discountAmount : 0)
        + (items.size() > 2 ? items[2].discountAmount : 0);
    }

    function validSaleShape(data) {
      return data.keys().hasAll([
          'operationId', 'number', 'status', 'agentId', 'clientId',
          'clientSnapshot', 'items', 'subtotal', 'lineDiscountTotal',
          'globalDiscountAmount', 'totalDiscount', 'total', 'paymentMethod',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'operationId', 'number', 'status', 'agentId', 'clientId',
          'clientSnapshot', 'items', 'subtotal', 'lineDiscountTotal',
          'globalDiscountType', 'globalDiscountValue', 'globalDiscountAmount',
          'totalDiscount', 'total', 'paymentMethod', 'paymentReference',
          'notes', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.operationId is string
        && data.operationId.matches('^[A-Za-z0-9_-]{8,100}$')
        && data.number is string
        && data.number.matches('^V-[0-9]{6,}$')
        && data.status == 'completed'
        && data.agentId is string
        && data.clientId is string
        && data.clientSnapshot is map
        && data.clientSnapshot.keys().hasAll(['name', 'documentType', 'documentNumber'])
        && data.clientSnapshot.keys().hasOnly(['name', 'documentType', 'documentNumber'])
        && data.clientSnapshot.name is string
        && data.clientSnapshot.documentType is string
        && data.clientSnapshot.documentNumber is string
        && validSaleItems(data.items)
        && data.subtotal is int
        && data.subtotal == saleSubtotal(data.items)
        && data.lineDiscountTotal is int
        && data.lineDiscountTotal == saleLineDiscount(data.items)
        && data.globalDiscountAmount is int
        && data.globalDiscountAmount >= 0
        && data.globalDiscountAmount <= data.subtotal - data.lineDiscountTotal
        && data.totalDiscount is int
        && data.totalDiscount == data.lineDiscountTotal + data.globalDiscountAmount
        && data.total is int
        && data.total == data.subtotal - data.totalDiscount
        && data.total >= 0
        && data.totalDiscount * 100 <= data.subtotal * 20
        && (
          !data.keys().hasAny(['globalDiscountType', 'globalDiscountValue'])
          || data.keys().hasAll(['globalDiscountType', 'globalDiscountValue'])
            && data.globalDiscountType in ['percentage', 'fixed']
            && data.globalDiscountValue is number
            && data.globalDiscountValue >= 0
            && (data.globalDiscountType != 'percentage' || data.globalDiscountValue <= 100)
        )
        && data.paymentMethod in ['cash', 'yape', 'plin', 'bank_transfer', 'card', 'other']
        && (!data.keys().hasAny(['paymentReference']) || data.paymentReference is string && data.paymentReference.size() <= 100)
        && (!data.keys().hasAny(['notes']) || data.notes is string && data.notes.size() <= 300)
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validSaleClient(data) {
      let client = get(/databases/$(database)/documents/clients/$(data.clientId)).data;
      return client.active == true
        && data.clientSnapshot.name == client.name
        && data.clientSnapshot.documentType == client.documentType
        && data.clientSnapshot.documentNumber == client.documentNumber;
    }

    function saleItemMatches(items, productId, quantity) {
      return items[0].productId == productId && items[0].quantity == quantity
        || items.size() > 1 && items[1].productId == productId && items[1].quantity == quantity
        || items.size() > 2 && items[2].productId == productId && items[2].quantity == quantity;
    }

    function validSaleMovementExists(saleId, agentId, item) {
      let movementId = 'sale__' + saleId + '__' + item.productId;
      let movement = getAfter(/databases/$(database)/documents/inventory_movements/$(movementId)).data;
      return movement.inventoryId == 'agent__' + agentId + '__' + item.productId
        && movement.productId == item.productId
        && movement.ownerType == 'agent'
        && movement.ownerId == agentId
        && movement.type == 'sale'
        && movement.quantity == item.quantity
        && movement.referenceType == 'sale'
        && movement.referenceId == saleId
        && movement.createdBy == request.auth.uid;
    }

    function validAllSaleItems(saleId, agentId, items) {
      return validSaleMovementExists(saleId, agentId, items[0])
        && (items.size() < 2 || validSaleMovementExists(saleId, agentId, items[1]))
        && (items.size() < 3 || validSaleMovementExists(saleId, agentId, items[2]));
    }

    function saleItemMatchesProduct(items, movement, product) {
      return items[0].productId == movement.productId
          && items[0].quantity == movement.quantity
          && items[0].sku == product.sku
          && items[0].name == product.name
          && items[0].unitPrice >= product.salePrice * 100 - 0.5
          && items[0].unitPrice < product.salePrice * 100 + 0.5
          && items[0].unitCost >= product.costPrice * 100 - 0.5
          && items[0].unitCost < product.costPrice * 100 + 0.5
        || items.size() > 1
          && items[1].productId == movement.productId
          && items[1].quantity == movement.quantity
          && items[1].sku == product.sku
          && items[1].name == product.name
          && items[1].unitPrice >= product.salePrice * 100 - 0.5
          && items[1].unitPrice < product.salePrice * 100 + 0.5
          && items[1].unitCost >= product.costPrice * 100 - 0.5
          && items[1].unitCost < product.costPrice * 100 + 0.5
        || items.size() > 2
          && items[2].productId == movement.productId
          && items[2].quantity == movement.quantity
          && items[2].sku == product.sku
          && items[2].name == product.name
          && items[2].unitPrice >= product.salePrice * 100 - 0.5
          && items[2].unitPrice < product.salePrice * 100 + 0.5
          && items[2].unitCost >= product.costPrice * 100 - 0.5
          && items[2].unitCost < product.costPrice * 100 + 0.5;
    }

    function validSaleInventory(before, after) {
      let movement = getAfter(/databases/$(database)/documents/inventory_movements/$(after.lastMovementId)).data;
      return isSignedIn()
        && after.ownerType == 'agent'
        && after.ownerId == request.auth.uid
        && movement.type == 'sale'
        && movement.referenceType == 'sale'
        && movement.inventoryId == 'agent__' + request.auth.uid + '__' + after.productId
        && movement.productId == after.productId
        && movement.ownerType == 'agent'
        && movement.ownerId == request.auth.uid
        && movement.quantity == before.quantity - after.quantity
        && movement.quantityBefore == before.quantity
        && movement.quantityAfter == after.quantity
        && movement.createdBy == request.auth.uid
        && after.lastMovementId == 'sale__' + movement.referenceId + '__' + after.productId;
    }

    function validSaleMovement(movementId, data) {
      let intent = getAfter(/databases/$(database)/documents/sale_intents/$(data.referenceId)).data;
      let product = get(/databases/$(database)/documents/products/$(data.productId)).data;
      return isSignedIn()
        && data.type == 'sale'
        && data.referenceType == 'sale'
        && data.ownerType == 'agent'
        && data.ownerId == request.auth.uid
        && data.inventoryId == 'agent__' + request.auth.uid + '__' + data.productId
        && movementId == 'sale__' + data.referenceId + '__' + data.productId
        && data.quantityAfter == data.quantityBefore - data.quantity
        && intent.status == 'consumed'
        && intent.agentId == request.auth.uid
        && product.active == true
        && saleItemMatchesProduct(intent.sale.items, data, product);
    }

    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if isAdmin() || isAgent();

      allow create: if isAdmin()
        && hasValidProductShape(request.resource.data)
        && existsAfter(/databases/$(database)/documents/product_skus/$(request.resource.data.sku))
        && getAfter(/databases/$(database)/documents/product_skus/$(request.resource.data.sku)).data.productId == productId
        && getAfter(/databases/$(database)/documents/product_skus/$(request.resource.data.sku)).data.sku == request.resource.data.sku;

      allow update: if isAdmin()
        && hasValidProductShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && existsAfter(/databases/$(database)/documents/product_skus/$(request.resource.data.sku))
        && getAfter(/databases/$(database)/documents/product_skus/$(request.resource.data.sku)).data.productId == productId
        && getAfter(/databases/$(database)/documents/product_skus/$(request.resource.data.sku)).data.sku == request.resource.data.sku
        && (
          request.resource.data.sku == resource.data.sku
          || !existsAfter(/databases/$(database)/documents/product_skus/$(resource.data.sku))
        );

      allow delete: if false;
    }

    match /product_skus/{skuId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['productId', 'sku'])
        && request.resource.data.keys().hasOnly(['productId', 'sku'])
        && request.resource.data.productId is string
        && request.resource.data.sku == skuId
        && existsAfter(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && getAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.sku == skuId;

      allow update: if false;

      allow delete: if isAdmin()
        && existsAfter(/databases/$(database)/documents/products/$(resource.data.productId))
        && getAfter(/databases/$(database)/documents/products/$(resource.data.productId)).data.sku != skuId;
    }

    match /clients/{clientId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && hasValidClientShape(request.resource.data)
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/client_documents/$(request.resource.data.documentType + '_' + request.resource.data.normalizedDocumentNumber))
        && getAfter(/databases/$(database)/documents/client_documents/$(request.resource.data.documentType + '_' + request.resource.data.normalizedDocumentNumber)).data.clientId == clientId
        && getAfter(/databases/$(database)/documents/client_documents/$(request.resource.data.documentType + '_' + request.resource.data.normalizedDocumentNumber)).data.documentType == request.resource.data.documentType
        && getAfter(/databases/$(database)/documents/client_documents/$(request.resource.data.documentType + '_' + request.resource.data.normalizedDocumentNumber)).data.documentNumber == request.resource.data.normalizedDocumentNumber;

      allow update: if isStaff()
        && hasValidClientShape(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/client_documents/$(request.resource.data.documentType + '_' + request.resource.data.normalizedDocumentNumber))
        && getAfter(/databases/$(database)/documents/client_documents/$(request.resource.data.documentType + '_' + request.resource.data.normalizedDocumentNumber)).data.clientId == clientId
        && (
          request.resource.data.documentType == resource.data.documentType
            && request.resource.data.normalizedDocumentNumber == resource.data.normalizedDocumentNumber
          || !existsAfter(/databases/$(database)/documents/client_documents/$(resource.data.documentType + '_' + resource.data.normalizedDocumentNumber))
        );

      allow delete: if false;
    }

    match /client_documents/{documentKey} {
      allow read: if isStaff();

      allow create: if isStaff()
        && request.resource.data.keys().hasAll(['clientId', 'documentType', 'documentNumber'])
        && request.resource.data.keys().hasOnly(['clientId', 'documentType', 'documentNumber'])
        && request.resource.data.clientId is string
        && request.resource.data.documentType in ['DNI', 'RUC', 'CE', 'OTHER']
        && request.resource.data.documentNumber is string
        && documentKey == request.resource.data.documentType + '_' + request.resource.data.documentNumber
        && existsAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId))
        && getAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.documentType == request.resource.data.documentType
        && getAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.normalizedDocumentNumber == request.resource.data.documentNumber;

      allow update: if false;

      allow delete: if isStaff()
        && existsAfter(/databases/$(database)/documents/clients/$(resource.data.clientId))
        && documentKey != getAfter(/databases/$(database)/documents/clients/$(resource.data.clientId)).data.documentType + '_' + getAfter(/databases/$(database)/documents/clients/$(resource.data.clientId)).data.normalizedDocumentNumber;
    }

    match /inventory/{inventoryId} {
      allow get: if isSignedIn()
          && inventoryId.matches('agent__' + request.auth.uid + '__.*')
        || isAdmin();

      allow list: if isAdmin()
        || isAgent()
          && resource.data.ownerType == 'agent'
          && resource.data.ownerId == request.auth.uid;

      allow create: if hasValidInventoryShape(request.resource.data)
        && inventoryId == request.resource.data.ownerType + '__' + request.resource.data.ownerId + '__' + request.resource.data.productId
        && (
          isAdmin()
            && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
            && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.active == true
            && validInventoryOwner(request.resource.data)
            && validInitialMovement(inventoryId, request.resource.data)
          || validReplenishmentInventoryIn(
            0,
            request.resource.data
          )
        );

      allow update: if hasValidInventoryShape(request.resource.data)
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.ownerType == resource.data.ownerType
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastMovementId != resource.data.lastMovementId
        && (
          request.resource.data.lastMovementId.matches('^sale__.*')
            && validSaleInventory(
              resource.data,
              request.resource.data
            )
          || isAdmin()
            && validAdjustmentMovement(
              inventoryId,
              resource.data.quantity,
              request.resource.data
            )
          || validReplenishmentInventoryOut(
            resource.data,
            request.resource.data
          )
          || validReplenishmentInventoryIn(
            resource.data.quantity,
            request.resource.data
          )
        );

      allow delete: if false;
    }

    match /inventory_movements/{movementId} {
      allow read: if isAdmin()
        || isAgent()
          && resource.data.ownerType == 'agent'
          && resource.data.ownerId == request.auth.uid;

      allow create: if hasValidMovementShape(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && movementMatchesInventory(movementId, request.resource.data)
        && (
          request.resource.data.type == 'sale'
            && validSaleMovement(movementId, request.resource.data)
          || isAdmin()
            && (
              request.resource.data.type == 'initial'
                && !exists(/databases/$(database)/documents/inventory/$(request.resource.data.inventoryId))
                && request.resource.data.quantityBefore == 0
                && request.resource.data.quantityAfter == request.resource.data.quantity
              || request.resource.data.type in ['adjustment_in', 'adjustment_out']
                && exists(/databases/$(database)/documents/inventory/$(request.resource.data.inventoryId))
                && get(/databases/$(database)/documents/inventory/$(request.resource.data.inventoryId)).data.quantity == request.resource.data.quantityBefore
                && (
                  request.resource.data.type == 'adjustment_in'
                    && request.resource.data.quantityAfter == request.resource.data.quantityBefore + request.resource.data.quantity
                  || request.resource.data.type == 'adjustment_out'
                    && request.resource.data.quantityAfter == request.resource.data.quantityBefore - request.resource.data.quantity
                )
            )
          || validReplenishmentMovement(movementId, request.resource.data)
        );

      allow update, delete: if false;
    }

    match /system_counters/{counterId} {
      allow read: if isSignedIn() && counterId == 'sales' || isAdmin();
      allow create: if (
          isAdmin() && counterId == 'replenishments'
          || isAgent() && counterId == 'sales'
        )
        && request.resource.data.keys().hasAll(['count'])
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if (
          isAdmin() && counterId == 'replenishments'
          || isAgent() && counterId == 'sales'
        )
        && request.resource.data.keys().hasAll(['count'])
        && request.resource.data.keys().hasOnly(['count'])
        && resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    match /replenishments/{replenishmentId} {
      allow read: if isAdmin()
        || isAgent() && resource.data.agentId == request.auth.uid;

      allow create: if isAdmin()
        && validReplenishmentShape(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && validReplenishmentAgent(request.resource.data.agentId)
        && validActiveReplenishmentProducts(request.resource.data.items);

      allow update: if validReplenishmentShape(request.resource.data)
        && (
          isAdmin()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.number == resource.data.number
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt
            && validReplenishmentAgent(request.resource.data.agentId)
            && validActiveReplenishmentProducts(request.resource.data.items)
          || isAdmin()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && unchangedReplenishmentCore(resource.data, request.resource.data)
            && request.resource.data.cancelledBy == request.auth.uid
          || isAdmin()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'sent'
            && unchangedReplenishmentCore(resource.data, request.resource.data)
            && request.resource.data.sentBy == request.auth.uid
            && validReplenishmentAgent(request.resource.data.agentId)
            && validActiveReplenishmentProducts(request.resource.data.items)
            && validAllSentItems(replenishmentId, request.resource.data.items)
          || isAgent()
            && resource.data.status == 'sent'
            && resource.data.agentId == request.auth.uid
            && request.resource.data.status == 'received'
            && unchangedReplenishmentCore(resource.data, request.resource.data)
            && request.resource.data.sentBy == resource.data.sentBy
            && request.resource.data.sentAt == resource.data.sentAt
            && request.resource.data.receivedBy == request.auth.uid
            && validAllReceivedItems(
              replenishmentId,
              request.auth.uid,
              request.resource.data.items
            )
        );

      allow delete: if false;
    }

    match /sales/{saleId} {
      allow get: if isSignedIn() && resource == null
        || isAdmin()
        || isAgent() && resource.data.agentId == request.auth.uid;

      allow list: if isAdmin()
        || isAgent() && resource.data.agentId == request.auth.uid;

      allow create: if isSignedIn()
        && saleId == request.resource.data.operationId
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/sale_intents/$(saleId)).data.status == 'consumed'
        && getAfter(/databases/$(database)/documents/sale_intents/$(saleId)).data.sale == request.resource.data
        && validAllSaleItems(
          saleId,
          request.auth.uid,
          request.resource.data.items
        );

      allow update, delete: if false;
    }

    match /sale_intents/{intentId} {
      allow get: if isSignedIn()
        && (resource == null || resource.data.agentId == request.auth.uid);
      allow list: if false;

      allow create: if isAgent()
        && request.resource.data.keys().hasAll(['status', 'agentId', 'sale'])
        && request.resource.data.keys().hasOnly(['status', 'agentId', 'sale'])
        && request.resource.data.status == 'prepared'
        && request.resource.data.agentId == request.auth.uid
        && request.resource.data.sale.operationId == intentId
        && request.resource.data.sale.agentId == request.auth.uid
        && request.resource.data.sale.createdBy == request.auth.uid
        && validSaleShape(request.resource.data.sale)
        && validSaleClient(request.resource.data.sale);

      allow update: if isSignedIn()
        && resource.data.status == 'prepared'
        && resource.data.agentId == request.auth.uid
        && request.resource.data.keys().hasAll(['status', 'agentId', 'sale'])
        && request.resource.data.keys().hasOnly(['status', 'agentId', 'sale'])
        && request.resource.data.status == 'consumed'
        && request.resource.data.agentId == resource.data.agentId
        && request.resource.data.sale == resource.data.sale
        && getAfter(/databases/$(database)/documents/sales/$(intentId)).data == resource.data.sale;

      allow delete: if false;
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
